# --- Core Server ---
ENVIRONMENT=production
APP_VERSION=1.2.0
PORT=8000
ALLOWED_ORIGINS=https://smartinvoice.yourdomain.com,https://smartinvoice-frontend.vercel.app
FRONTEND_URL=https://smartinvoice-frontend.vercel.app

# --- Database (PostgreSQL / Supabase / MySQL) ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres

# --- Razorpay Credentials (Live & Test) ---
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_HMAC_SECRET

# --- Google Gemini / LLM ---
LLM_PROVIDER=gemini
LLM_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Transactional Email (Resend) ---
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX
SENDER_EMAIL=billing@yourdomain.com
DEFAULT_RECIPIENT_EMAIL=finance@yourdomain.com

# --- Gmail / SMTP Email (Fallback) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# --- Clerk Authentication ---
CLERK_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXX
CLERK_ISSUER=https://clerk.yourdomain.com

# --- Escalation Rules ---
MAX_TOUCHES_PER_INVOICE=3
COOLDOWN_DAYS_BETWEEN_TOUCHES=4
PROMISE_CONFIDENCE_THRESHOLD=0.7

# --- Monitoring & Background Queues (Optional) ---
SENTRY_DSN=
CELERY_BROKER_URL=redis://localhost:6379/0


