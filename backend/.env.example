# --- Core Server ---
ENVIRONMENT=development
APP_VERSION=1.2.0
PORT=8000
ALLOWED_ORIGINS=*
FRONTEND_URL=http://localhost:3000

# --- Database ---
# Default is embedded SQLite: zero setup, file created on first run.
DATABASE_URL=sqlite:///./promise_to_pay.db
# For Postgres/Supabase or MySQL instead, replace the line above with one of:
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres
#   DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/promise_to_pay_db

# --- Razorpay Credentials (Live & Test) ---
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET
# Copy this from the Razorpay dashboard when you create the webhook.
# Set it   -> every incoming webhook must carry a matching X-Razorpay-Signature
#             or it is rejected with a 400.
# Leave it -> the event is still accepted so the demo runs offline, but the audit
#    empty    trail records that the payment was never cryptographically verified.
RAZORPAY_WEBHOOK_SECRET=

# --- Google Gemini / LLM ---
# Leave LLM_API_KEY empty to use the deterministic heuristic extractor (works offline).
LLM_PROVIDER=gemini
LLM_API_KEY=

# --- Transactional Email (Resend) ---
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX
SENDER_EMAIL=billing@yourdomain.com
DEFAULT_RECIPIENT_EMAIL=finance@yourdomain.com

# --- Gmail / SMTP Email (Fallback) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# --- Clerk Authentication ---
CLERK_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXX
CLERK_ISSUER=https://clerk.yourdomain.com

# --- Escalation Rules ---
MAX_TOUCHES_PER_INVOICE=3
COOLDOWN_DAYS_BETWEEN_TOUCHES=4
PROMISE_CONFIDENCE_THRESHOLD=0.7

